# Persistência opcional em PostgreSQL.
# SEM este arquivo (ou sem DATABASE_URL), o app roda 100% em memória — as buscas
# somem ao reiniciar. COM ele, buscas, leads, enriquecimento e estágios do Kanban
# ficam salvos no banco.
#
# O banco mora no home server (ZimaOS) e é acessado via Tailscale (IP 100.x).
# Copie este arquivo para `.env` e ajuste a senha.
DATABASE_URL=postgresql://captacao_app:SUA_SENHA@100.x.y.z:5432/captacao
