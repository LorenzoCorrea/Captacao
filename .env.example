# ─────────────────────────────────────────────────────────────────────────────
# .env do docker-compose.yml — usado quando você sobe o sistema via Docker
# (ZimaOS, servidor caseiro, VPS, etc.). Para rodar a API/Front diretamente
# fora de Docker (npm run dev), use server/.env.
#
# Como usar:
#   1. cp .env.example .env
#   2. Edite os valores abaixo
#   3. docker compose up -d --build
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ──────────────────────────────────────────────────────────────
# IMPORTANTE: dentro do container do app, o host do Postgres é
# `host.docker.internal` (mapeado automaticamente para o IP do host pelo compose).
# Senha forte (>=20 chars gerados em Bitwarden/1Password). Não commite este arquivo.
#
# O banco "captacao" NÃO precisa existir: se o seu container do Postgres foi
# criado com outro POSTGRES_DB, a API cria o banco "captacao" automaticamente
# no primeiro boot (e as tabelas também). Basta usuário e senha estarem certos.
DATABASE_URL=postgresql://lorenzo:TROQUE_AQUI@host.docker.internal:5432/captacao

# ── Contato para as APIs do OpenStreetMap (opcional) ───────────────────────
# Por etiqueta, Overpass/Nominatim pedem um contato no User-Agent. O padrão é
# a URL deste repositório; se preferir e-mail, defina aqui (fica só no .env,
# fora do Git — nada de e-mail pessoal hardcoded em repo público).
# OSM_CONTACT=seu-email@exemplo.com

# ── Prévia de site (opcional) ───────────────────────────────────────────────
# Seu WhatsApp com DDD: liga o botão "Quero meu site" na faixa de venda da
# prévia (/previa/:searchId/:leadId). Ex.: 51999998888
# SELLER_WHATSAPP=

# ── Comportamento do enriquecimento (opcional) ──────────────────────────────
# ENRICH_CONCURRENCY=2          # leads enriquecidos em paralelo (padrão 2)
# ENRICH_BACKGROUND=true        # false = só enriquece quando o usuário clica
# DATA_PROVIDER=osm             # mock = dados fictícios offline
# ENRICH_PROVIDER=python        # mock = contatos fictícios sem chamar DDG
